// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 🗂️ 1. DATA ENUMS

enum InvoiceStatus {
  UPLOADED
  EXTRACTING
  NEEDS_REVIEW
  APPROVED
  REJECTED
  EXTRACTION_FAILED
}

enum FlagSeverity {
  INFO
  WARNING
  CRITICAL
}

enum FlagStatus {
  OPEN
  DISMISSED
  RESOLVED
}

enum AuditRule {
  LINE_ITEMS_SUM_MISMATCH
  TOTAL_MISMATCH
  DUPLICATE_INVOICE
  UNUSUAL_AMOUNT
}

//  DATA MODELS WITH SNAKE_CASE MAPS

model Vendor {
  id             String   @id @default(uuid()) @map("id")
  organizationId String   @map("organization_id")
  name           String   @map("name")
  normalizedName String   @map("normalized_name")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  invoices     Invoice[]
  organization Organization @relation(fields: [organizationId], references: [id])

  // Maps PascalCase Model to snake_case table
  @@unique([organizationId, normalizedName])
  @@index([organizationId])
  @@map("vendors")
}

model Invoice {
  id              String        @id @default(uuid()) @map("id")
  organizationId  String        @map("organization_id")
  uploadedById    String        @map("uploaded_by_id")
  vendorId        String?       @map("vendor_id")
  status          InvoiceStatus @default(UPLOADED) @map("status")
  invoiceNumber   String?       @map("invoice_number")
  invoiceDate     DateTime?     @map("invoice_date") @db.Date
  dueDate         DateTime?     @map("due_date") @db.Date
  currency        String?       @map("currency")
  subtotalCents   Int?          @map("subtotal_cents")
  taxCents        Int?          @map("tax_cents")
  totalCents      Int?          @map("total_cents")
  fileUrl         String        @map("file_url")
  fileName        String        @map("file_name")
  mimeType        String        @map("mime_type")
  fileHash        String        @map("file_hash")
  aiExtraction    Json?         @map("ai_extraction")
  fieldConfidence Json?         @map("field_confidence")
  errorMessage    String?       @map("error_message")
  reviewedById    String?       @map("reviewed_by_id")
  reviewedAt      DateTime?     @map("reviewed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  reviewer     User?    @relation("ReviewedInvoices", fields: [reviewedById], references: [id])
  uploader     User     @relation("UploadedInvoices", fields: [uploadedById], references: [id], onDelete: Restrict)

  lineItems    InvoiceLineItem[]
  auditFlags   AuditFlag[]
  organization Organization      @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, invoiceDate])
  @@index([organizationId, vendorId])
  @@index([organizationId, vendorId, invoiceNumber])
  @@index([organizationId, fileHash])
  @@map("invoices")
}

model InvoiceLineItem {
  id             String  @id @default(uuid()) @map("id")
  organizationId String  @map("organization_id")
  invoiceId      String  @map("invoice_id")
  position       Int     @map("position")
  description    String  @map("description")
  quantity       Decimal @map("quantity") @db.Decimal(12, 4)
  unitPriceCents Int     @map("unit_price_cents")
  amountCents    Int     @map("amount_cents")

  // Relations
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model AuditFlag {
  id             String       @id @default(uuid()) @map("id")
  organizationId String       @map("organization_id")
  invoiceId      String       @map("invoice_id")
  rule           AuditRule    @map("rule")
  severity       FlagSeverity @map("severity")
  status         FlagStatus   @default(OPEN) @map("status")
  message        String       @map("message")
  createdAt      DateTime     @default(now()) @map("created_at")
  dismissedById  String?      @map("dismissed_by_id")
 

  // Relations
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([invoiceId])
  @@map("audit_flags")
}

model User {
  id            String       @id @default(uuid()) @map("id")
  name          String       @map("name")
  email         String       @map("email")
  emailVerified Boolean      @default(false) @map("email_verified")
  image         String?      @map("image")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt      @map("updated_at")
  sessions      Session[]
  accounts      Account[]    
  members       Member[]
  invitations   Invitation[]
  reviewedInvoices Invoice[] @relation("ReviewedInvoices")
  uploadedInvoices Invoice[] @relation("UploadedInvoices")

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id @map("id")
  expiresAt            DateTime @map("expires_at")
  token                String   @map("token")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt      @map("updated_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id") 
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?   @map("active_organization_id")

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @map("id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @map("scope")
  password              String?   @map("password")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt     @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @map("id")
  identifier String   @map("identifier")
  value      String   @map("value")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id              String            @id @map("id")
  name            String           @map("name")
  slug            String           @map("slug")
  logo            String?          @map("logo")
  createdAt       DateTime         @map("crated_at")
  metadata        String?          @map("metadata")
  members         Member[]         
  invitations     Invitation[]
  auditFlags       AuditFlag[]
  vendors          Vendor[]
  invoiceLineItems InvoiceLineItem[]
  invoices         Invoice[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id @map("id")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member") @map("role")
  createdAt      DateTime     @map("created_at")

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @map("id")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @map("email")
  role           String?      @map("role")
  status         String       @default("pending") @map("status")
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now())  @map("created_at")
  inviterId      String       @map("inviter_id")
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
